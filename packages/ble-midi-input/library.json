{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "ble-midi-input",
  "version": "0.2.0",
  "description": "BLE MIDI input transport for embedded music experiments",
  "keywords": ["ble", "midi", "embedded", "music"],
  "repository": {
    "type": "git",
    "url": "https://github.com/fczuardi/midi-receiver.git"
  },
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": [
    "BleMidiInput.h",
    "BleMidiPacketParser.h",
    "MidiNoteEventFactory.h"
  ],
  "dependencies": [
    {
      "name": "firmware-contracts",
      "version": "https://github.com/fczuardi/embedded-music-experiments.git#c9bde598cff9"
    },
    {
      "owner": "h2zero",
      "name": "NimBLE-Arduino",
      "version": "2.5.1"
    }
  ],
  "build": {
    "srcFilter": [
      "-<*>",
      "+<BleMidiInput.cpp>",
      "+<BleMidiPacketParser.cpp>",
      "+<MidiNoteEventFactory.cpp>"
    ]
  },
  "export": {
    "include": [
      "README.md",
      "include/BleMidiInput.h",
      "include/BleMidiPacketParser.h",
      "include/MidiNoteEventFactory.h",
      "src/BleMidiInput.cpp",
      "src/BleMidiPacketParser.cpp",
      "src/MidiNoteEventFactory.cpp",
      "library.json"
    ]
  }
}
