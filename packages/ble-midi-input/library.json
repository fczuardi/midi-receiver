{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "ble-midi-input",
  "version": "0.1.1",
  "description": "BLE MIDI input transport for embedded music experiments",
  "keywords": ["ble", "midi", "embedded", "music"],
  "repository": {
    "type": "git",
    "url": "https://github.com/fczuardi/midi-receiver.git"
  },
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": ["BleMidiInput.h", "MidiNoteEventFactory.h"],
  "dependencies": [
    {
      "name": "EmbeddedMusicFirmwareContracts",
      "version": "https://github.com/fczuardi/embedded-music-experiments.git#154035d94df99ab05c3eeb7eb144bf2012972ada"
    },
    {
      "owner": "lathoub",
      "name": "BLE-MIDI",
      "version": "2.2"
    }
  ],
  "build": {
    "srcFilter": [
      "-<*>",
      "+<BleMidiInput.cpp>",
      "+<MidiNoteEventFactory.cpp>"
    ]
  },
  "export": {
    "include": [
      "README.md",
      "include/BleMidiInput.h",
      "include/MidiNoteEventFactory.h",
      "src/BleMidiInput.cpp",
      "src/MidiNoteEventFactory.cpp",
      "library.json"
    ]
  }
}
